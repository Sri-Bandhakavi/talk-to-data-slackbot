# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Logging verbosity
LOG_LEVEL=INFO

# OpenAI / PandasAI (required for analytics)
# OPENAI_API_KEY=
# PANDASAI_MODEL=gpt-4o-mini

# Slack app credentials (Component 7 — Socket Mode)
# Bot User OAuth Token (xoxb-...)
# SLACK_BOT_TOKEN=
# App-level token for Socket Mode (xapp-...)
# SLACK_APP_TOKEN=
# Signing secret (HTTP Events API; not required for Socket Mode)
# SLACK_SIGNING_SECRET=
